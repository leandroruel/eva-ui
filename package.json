{
  "name": "eva-ui",
  "version": "0.1.0",
  "private": true,
  "description": "EVA NERV theme — design system extraído de EvangelionNERVDashboard.jsx",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
